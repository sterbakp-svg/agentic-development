{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-composer.example/schemas/manual-eval-run/1.0.json",
  "title": "Manual eval run (ADR-001 section 8)",
  "description": "Result form of one manual eval run in the company test environment. The zod schema in packages/evals/src/schema.ts is the source of truth. This schema states the same structural rules (JD cases without inputFile, outputFile, flow and expectReject; the other cases with the first three; interviewPromptVersion when a JD case is present; flow.valid matches flow.errorCodes; unique scorers). Rules that JSON Schema cannot state are left to zod: scorers named in scores are listed in scorers, and caseId plus attempt are unique. Only fictional data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "date",
    "environment",
    "solutionVersion",
    "templateVersion",
    "promptVersion",
    "promptOption",
    "model",
    "scorers",
    "cases"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "environment": {
      "const": "company-test"
    },
    "solutionVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "templateVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "interviewPromptVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "promptOption": {
      "enum": [
        "A",
        "B"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scorers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
    },
    "code": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "score": {
      "enum": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "scorerScores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_fit",
        "faithfulness",
        "stakeholder_order",
        "language",
        "placeholders",
        "questions"
      ],
      "properties": {
        "role_fit": {
          "$ref": "#/$defs/score"
        },
        "faithfulness": {
          "$ref": "#/$defs/score"
        },
        "stakeholder_order": {
          "$ref": "#/$defs/score"
        },
        "language": {
          "$ref": "#/$defs/score"
        },
        "placeholders": {
          "$ref": "#/$defs/score"
        },
        "questions": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "attempt",
        "retried"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}-\\d{2}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "inputFile": {
          "$ref": "#/$defs/path"
        },
        "outputFile": {
          "$ref": "#/$defs/path"
        },
        "retried": {
          "type": "boolean"
        },
        "flow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valid",
            "errorCodes",
            "warningCodes",
            "chars"
          ],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "errorCodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/code"
              }
            },
            "warningCodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/code"
              }
            },
            "chars": {
              "type": "integer",
              "minimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "valid": {
                    "const": true
                  }
                },
                "required": [
                  "valid"
                ]
              },
              "then": {
                "properties": {
                  "errorCodes": {
                    "maxItems": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "errorCodes": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/scorerScores"
          }
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "expectReject": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "caseId": {
            "pattern": "^JD-"
          }
        },
        "required": [
          "caseId"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "inputFile"
              ]
            },
            {
              "required": [
                "outputFile"
              ]
            },
            {
              "required": [
                "flow"
              ]
            },
            {
              "required": [
                "expectReject"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "inputFile",
          "outputFile",
          "flow"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cases": {
            "contains": {
              "properties": {
                "caseId": {
                  "pattern": "^JD-"
                }
              },
              "required": [
                "caseId"
              ]
            }
          }
        },
        "required": [
          "cases"
        ]
      },
      "then": {
        "required": [
          "interviewPromptVersion"
        ]
      }
    }
  ]
}
