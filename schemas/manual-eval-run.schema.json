{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-composer.example/schemas/manual-eval-run/1.0.json",
  "title": "Manual eval run (ADR-001 section 8)",
  "description": "Result form of one manual eval run in the company test environment. The zod schema in packages/evals/src/schema.ts is the source of truth and is stricter: it also requires inputFile, outputFile and flow for every case that is not a JD case, forbids them for JD cases, requires interviewPromptVersion when a JD case is present, requires flow.valid to match flow.errorCodes, scorers to be unique and listed, and caseId plus attempt to be unique. Only fictional data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "date",
    "environment",
    "solutionVersion",
    "templateVersion",
    "promptVersion",
    "promptOption",
    "model",
    "scorers",
    "cases"
  ],
  "properties": {
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "environment": { "const": "company-test" },
    "solutionVersion": { "type": "string", "minLength": 1, "maxLength": 50 },
    "templateVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "promptVersion": { "type": "string", "minLength": 1, "maxLength": 50 },
    "interviewPromptVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "promptOption": { "enum": ["A", "B"] },
    "model": { "type": "string", "minLength": 1, "maxLength": 100 },
    "scorers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
    },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "score": { "enum": [1, 2, 3, 4, 5] },
    "scorerScores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_fit", "faithfulness", "stakeholder_order", "language", "placeholders", "questions"],
      "properties": {
        "role_fit": { "$ref": "#/$defs/score" },
        "faithfulness": { "$ref": "#/$defs/score" },
        "stakeholder_order": { "$ref": "#/$defs/score" },
        "language": { "$ref": "#/$defs/score" },
        "placeholders": { "$ref": "#/$defs/score" },
        "questions": { "$ref": "#/$defs/score" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "attempt", "retried"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^[A-Z]{1,3}-\\d{2}$" },
        "attempt": { "type": "integer", "minimum": 1 },
        "inputFile": { "$ref": "#/$defs/path" },
        "outputFile": { "$ref": "#/$defs/path" },
        "retried": { "type": "boolean" },
        "flow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "errorCodes", "warningCodes", "chars"],
          "properties": {
            "valid": { "type": "boolean" },
            "errorCodes": { "type": "array", "items": { "$ref": "#/$defs/code" } },
            "warningCodes": { "type": "array", "items": { "$ref": "#/$defs/code" } },
            "chars": { "type": "integer", "minimum": 0 }
          }
        },
        "scores": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scorerScores" } },
        "note": { "type": "string", "maxLength": 500 },
        "expectReject": { "type": "boolean" }
      }
    }
  }
}
