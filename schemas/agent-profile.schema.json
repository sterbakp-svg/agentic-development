{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-composer.example/schemas/agent-profile/1.0.json",
  "title": "Agent profile (input to the prompt generator)",
  "description": "Everything the generator needs to personalize an agent template for one user. The app never needs mailbox content.",
  "type": "object",
  "required": ["schema_version", "template_id", "user", "role", "languages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "template_id": { "type": "string", "enum": ["email-triage"] },

    "user": {
      "type": "object",
      "required": ["job_title"],
      "additionalProperties": false,
      "properties": {
        "display_name": { "type": "string", "maxLength": 60, "description": "Name used in the instructions. Empty means placeholder '[Name]'." },
        "job_title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "department": { "type": "string", "maxLength": 120 },
        "organization_name": { "type": "string", "maxLength": 120, "description": "Empty means placeholder '[company]'." },
        "organization_type": { "type": "string", "maxLength": 120, "description": "E.g. 'an insurance company in an international group'." },
        "industry": { "type": "string", "enum": ["financial_services", "insurance", "banking", "public_sector", "manufacturing", "retail", "it_services", "healthcare", "energy", "professional_services", "other"] },
        "seniority": { "type": "string", "enum": ["executive", "manager", "specialist", "other"] },
        "has_team": { "type": "boolean", "default": false },
        "delegation_roles": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 60 }, "description": "Roles the user can delegate to, e.g. 'IT operations lead'." }
      }
    },

    "role": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 20, "maxLength": 2000, "description": "Free text: what the user does. Can be a pasted job description." },
        "responsibilities": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 160 } },
        "ongoing_topics": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 120 } },
        "tools": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 40 } },
        "regulations": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 40 }, "description": "E.g. DORA, GDPR, NIS2." }
      }
    },

    "stakeholders": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["role_or_group", "relation"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 60 },
          "role_or_group": { "type": "string", "maxLength": 80 },
          "relation": { "type": "string", "enum": ["manager", "executive", "board", "peer", "direct_report", "team", "internal_function", "group_or_headquarters", "regulator", "auditor", "vendor", "client", "other"] },
          "priority": { "type": "string", "enum": ["highest", "high"], "default": "high" }
        }
      }
    },

    "priorities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "high_impact_areas": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 80 } },
        "extra_urgency_signals": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 80 } },
        "low_priority": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 80 }, "description": "Senders or topics to treat as FYI." },
        "confidential_topics": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 60 } }
      }
    },

    "languages": {
      "type": "object",
      "required": ["working", "overview"],
      "additionalProperties": false,
      "properties": {
        "working": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["en", "sk", "cs", "de"] } },
        "overview": { "enum": ["en", "sk", "cs", "de"] },
        "instructions": { "enum": ["en"], "default": "en", "description": "Language of the generated instructions. v1 supports 'en' only (recommended by evals). 'sk' arrives with template v1-sk." }
      }
    },

    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft_tone": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 30 } },
        "signature": { "type": "string", "maxLength": 60 }
      }
    },

    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 30, "default": "Inbox Triage" },
        "time_window_days": { "type": "integer", "minimum": 1, "maximum": 30, "default": 7 },
        "top_n": { "type": "integer", "minimum": 3, "maximum": 20, "default": 10 }
      }
    },

    "org_context": {
      "type": "object",
      "description": "Set by the organization admin, not by the end user. Phase 2.",
      "additionalProperties": false,
      "properties": {
        "organization_description": { "type": "string", "maxLength": 300 },
        "common_stakeholders": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 80 } },
        "mandatory_rule": { "type": "string", "maxLength": 300 }
      }
    }
  }
}
